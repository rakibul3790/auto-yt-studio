 "lines": [
  [
   "narrator",
   1.4,
   null,
   "Every spring, Grandpa built a kite."
  ],
  [
   "narrator",
   7.9,
   null,
   "And every spring, Scribble couldn't make it fly."
  ],
  [
   "grandpa",
   13.6,
   null,
   "You're pulling against the wind, little one."
  ],
  [
   "grandpa",
   18.9,
   null,
   "Don't fight it. Run with it... and let it lift you."
  ],
  [
   "narrator",
   30.6,
   null,
   "That spring, the kite touched the clouds."
  ],
  [
   "narrator",
   39.2,
   null,
   "Then the springs got shorter."
  ],
  [
   "narrator",
   44.4,
   null,
   "Scribble grew up. The city got loud."
  ],
  [
   "phone",
   54.0,
   null,
   "Wind's good this Sunday. Kite's ready... if you are."
  ],
  [
   "narrator",
   61.6,
   null,
   "He always meant to go. Next Sunday, he thought."
  ],
  [
   "narrator",
   69.2,
   null,
   "And then, one spring, there were no more Sundays."
  ],
  [
   "narrator",
   81.0,
   null,
   "He found the old kite in the attic. Torn. Tired. A lot like him."
  ],
  [
   "memory",
   94.2,
   null,
   "For the day the wind gets strong: don't fight it. Let it lift you."
  ],
  [
   "narrator",
   107.2,
   null,
   "So he fixed it. One patch at a time."
  ],
  [
   "narrator",
   114.2,
   null,
   "The wind was strong that morning."
  ],
  [
   "narrator",
   136.6,
   null,
   "The people who love us never really leave."
  ],
  [
   "narrator",
   140.4,
   null,
   "They stay... in the wind."
  ]
 ],
